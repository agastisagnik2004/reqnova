# Reqnova configuration - copy to .env and fill in. Never commit .env.
# Any OpenAI-compatible chat-completions endpoint
API_BASE_URL=https://your-provider.example.com/v1

# Reasoning models
MODEL_1=your-fast-reasoning-model-id
MODEL_1_API_KEY=your-key-here
MODEL_2=your-deep-reasoning-model-id
MODEL_2_API_KEY=your-key-here
# optional last-resort fallback (uses MODEL_2_API_KEY)
BACKUP_MODEL=
DEFAULT_MODEL_MODE=fast

# Vision model for images / scanned PDFs (primary, then optional fallback)
VISION_MODEL=your-vision-model-id
VISION_FALLBACK_MODEL=
VISION_API_KEY=your-key-here
